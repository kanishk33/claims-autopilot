# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Any model your account can use that supports Structured Outputs.
# Run `python scripts/check_openai.py` to confirm access before using the app.
OPENAI_MODEL=gpt-4.1-mini

# FREE OPTION: use a Google Gemini key instead of OpenAI (see docs/SETUP_GUIDE.md).
# Uncomment the OPENAI_BASE_URL line below, put your Gemini key in OPENAI_API_KEY above,
# and set OPENAI_MODEL to a Gemini model such as gemini-2.5-flash.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional settings
OPENAI_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
CLAIMS_DB_PATH=outputs/claims_autopilot.db
